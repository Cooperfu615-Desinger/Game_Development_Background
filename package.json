{
  "name": "aggregator-core",
  "description": "B2B Game Aggregation Platform",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "predev": "npm run spec:build",
    "dev": "vite",
    "prebuild": "npm run spec:build",
    "build": "vite build",
    "spec:build": "node scripts/build-spec-site.mjs",
    "spec:check": "npm run spec:build && node scripts/check-spec-site.mjs",
    "spec:batch-a-check": "npm run spec:check && node scripts/check-phase-one-seal.mjs && node scripts/check-batch-a.mjs",
    "spec:batch-b-check": "npm run spec:batch-a-check && node scripts/check-batch-b.mjs",
    "spec:batch-c-check": "npm run spec:batch-b-check && node scripts/check-batch-c.mjs",
    "spec:batch-d-check": "npm run spec:batch-c-check && node scripts/check-batch-d.mjs",
    "spec:decision-pack-01-check": "npm run spec:build && node scripts/check-decision-pack-01.mjs",
    "spec:decision-pack-02-check": "npm run spec:build && node scripts/check-decision-pack-02.mjs",
    "spec:decision-pack-02-source-check": "node scripts/check-decision-pack-02-source-specs.mjs",
    "spec:decision-pack-03-check": "npm run spec:build && node scripts/check-decision-pack-03.mjs",
    "spec:seal-check": "npm run spec:batch-d-check && node scripts/check-phase-two-seal.mjs && node scripts/check-decision-pack-01.mjs && node scripts/check-decision-pack-02.mjs && node scripts/check-decision-pack-02-source-specs.mjs && node scripts/check-decision-pack-03.mjs",
    "spec:seal": "npm run spec:seal-check && npm run type-check && npm run build",
    "type-check": "vue-tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@faker-js/faker": "^10.2.0",
    "@primeuix/themes": "^2.0.3",
    "@types/big.js": "^6.2.2",
    "@types/nprogress": "^0.2.3",
    "@vueuse/core": "^14.1.0",
    "big.js": "^7.0.1",
    "chart.js": "^4.5.1",
    "date-fns": "^4.1.0",
    "echarts": "^6.0.0",
    "marked": "^18.0.5",
    "msw": "^2.12.7",
    "nprogress": "^0.2.0",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.5",
    "tailwindcss-primeui": "^0.6.1",
    "vue": "^3.5.24",
    "vue-echarts": "^8.0.1",
    "vue-i18n": "^11.2.8",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.8.1",
    "autoprefixer": "^10.4.23",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vue-tsc": "^3.1.4"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
